# 复制为 .env 并填入你的 API key
DEEPSEEK_API_KEY=sk-your-key
# DeepSeek 兼容 OpenAI 接口
DEEPSEEK_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# ── 安全 / 限流(登录鉴权)────────────────────────────────────────
# JWT 签名 + settings.json 里 API Key 加密共用。
# 不填则首次启动自动生成 data/.secret(gitignore,单实例够用);
# 生产 / 多实例必须显式指定并保持稳定:openssl rand -base64 32
# SECRET_KEY=
# 每用户每分钟可提问次数(聊天接口限流,成本控制)
# CHAT_RATE_LIMIT_PER_MINUTE=30

# 嵌入:api=阿里百炼(DashScope),local=本地 BGE 模型
EMBEDDING_PROVIDER=api
EMBEDDING_MODEL=qwen3.7-text-embedding
# 阿里百炼 OpenAI 兼容接口(DashScope)
DASHSCOPE_API_KEY=sk-your-dashscope-key
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 本地 BGE 模型(EMBEDDING_PROVIDER=local 时使用,首次运行自动下载)
# EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# 是否启用重排 / 查询改写
USE_RERANK=1

# ── 重排 ─────────────────────────────────────────────────────────
# api = 阿里百炼 text-reranker(gte-rerank-v2,免下载、中文效果好)
# local = 本地 bge-reranker-v2-m3(离线 fallback,首次运行下载 ~2.3GB)
RERANK_PROVIDER=api
# RERANKER_MODEL=BAAI/bge-reranker-v2-m3
# DASHSCOPE_RERANK_MODEL=gte-rerank-v2
# DASHSCOPE_RERANK_URL=https://dashscope.aliyuncs.com/api/v1/services/rerank/text-rerank/text-rerank
